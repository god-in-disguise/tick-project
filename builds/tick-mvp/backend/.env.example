# Local Flash quote/chart evaluation: set ENABLED_VENUES=gtrade,flash.
# Live Flash execution also needs a Solana custody wallet and funded Flash
# basket for that user; it is deliberately disabled by default.
FLASH_API_URL=https://flashapi.trade
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
FLASH_REAL_EXECUTION_ENABLED=false
FLASH_SETUP_WALLET_PRIVATE_KEY=
FLASH_SETUP_TARGET_SOL=0.075
FLASH_SLIPPAGE_PERCENTAGE=0.5
FLASH_PRICE_POLL_SECONDS=0.2

# Avantis runs on a separate Base custody wallet and uses zero-fee-loss
# markets from the live SDK catalog. Live execution remains opt-in.
BASE_CHAIN_ID=8453
BASE_RPC_URL=
BASE_WSS_URL=
BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
